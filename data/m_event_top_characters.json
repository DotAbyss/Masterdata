[
  {
    "id": 1,
    "m_event_id": 300001,
    "m_character_id": 1300009,
    "character_asset_id": "100801000G",
    "position": 1,
    "face": "Normal",
    "serif": "ふふ。サプライズにしないと、\n司令官さまは恥ずかしがって、\n逃げちゃいそうですからねー",
    "serif_type": 1
  },
  {
    "id": 2,
    "m_event_id": 300001,
    "m_character_id": 1300009,
    "character_asset_id": "100801000G",
    "position": 1,
    "face": "Normal",
    "serif": "ウェンディさん、とっても\n張り切ってる……わたしたちも\n頑張ろうね、お姉ちゃん♪",
    "serif_type": 1
  },
  {
    "id": 3,
    "m_event_id": 300001,
    "m_character_id": 1300020,
    "character_asset_id": "102501000G",
    "position": 1,
    "face": "Normal",
    "serif": "サプライズパーティー……\n司令官、喜んでくれると\nいいなぁ～",
    "serif_type": 1
  },
  {
    "id": 4,
    "m_event_id": 300001,
    "m_character_id": 1300020,
    "character_asset_id": "102501000G",
    "position": 1,
    "face": "Normal",
    "serif": "えへへ……ヴィーラさんと\nベリサさんと一緒に準備するの、\nとっても楽しいです♪",
    "serif_type": 1
  },
  {
    "id": 5,
    "m_event_id": 300001,
    "m_character_id": 1300020,
    "character_asset_id": "100801000G",
    "position": 1,
    "face": "Normal",
    "serif": "ウェンディさんのためにも、\n必ずサプライズパーティーを\n成功させてみせます……！",
    "serif_type": 1
  },
  {
    "id": 6,
    "m_event_id": 300001,
    "m_character_id": 1200016,
    "character_asset_id": "100801000G",
    "position": 1,
    "face": "Normal",
    "serif": "もう、お姉ちゃんったら。\nウェンディさんを喜ばせたいって\n素直に言えばいいのに……ふふ",
    "serif_type": 1
  },
  {
    "id": 7,
    "m_event_id": 300001,
    "m_character_id": 1200016,
    "character_asset_id": "102501000G",
    "position": 1,
    "face": "Normal",
    "serif": "ヴィーラさん、ベリサさん……\nお二人が友だちでいてくれて、\nわたし、本当に幸せ者ですっ",
    "serif_type": 1
  },
  {
    "id": 8,
    "m_event_id": 300001,
    "m_character_id": 1200016,
    "character_asset_id": "102501000G",
    "position": 1,
    "face": "Normal",
    "serif": "友情の力は無限大です……！\nぱわぁぁぁぁぁあああ！！！！",
    "serif_type": 1
  },
  {
    "id": 9,
    "m_event_id": 300001,
    "m_character_id": 1200016,
    "character_asset_id": "102501000G",
    "position": 1,
    "face": "Normal",
    "serif": "司令官に喜んでもらえました～！\nサプライズ、大成功です♪",
    "serif_type": 2
  },
  {
    "id": 10,
    "m_event_id": 300001,
    "m_character_id": 1200016,
    "character_asset_id": "102501000G",
    "position": 1,
    "face": "Normal",
    "serif": "ヴィーラさん、ベリサさん、\n本当にありがとうござます！\n大好きです♪",
    "serif_type": 2
  },
  {
    "id": 11,
    "m_event_id": 300001,
    "m_character_id": 1200016,
    "character_asset_id": "100801000G",
    "position": 1,
    "face": "Normal",
    "serif": "ウェンディさん、\nとっても嬉しそう……\nえへへ、やったねお姉ちゃん♪",
    "serif_type": 2
  },
  {
    "id": 12,
    "m_event_id": 300001,
    "m_character_id": 1200016,
    "character_asset_id": "100801000G",
    "position": 1,
    "face": "Normal",
    "serif": "ふふ……\n次は、わたしとお姉ちゃんの\n再会パーティーもしなくっちゃ♪",
    "serif_type": 2
  },
  {
    "id": 300002001,
    "m_event_id": 300002,
    "m_character_id": 1300029,
    "character_asset_id": "105801000G",
    "position": 1,
    "face": "Normal",
    "serif": "旦那様が私と一緒に鬼ヶ島へ\n里帰りしてくださるのですか！？\nもしや結婚の挨拶のために！？",
    "serif_type": 1
  },
  {
    "id": 300002002,
    "m_event_id": 300002,
    "m_character_id": 1300029,
    "character_asset_id": "105801000G",
    "position": 1,
    "face": "Normal",
    "serif": "仲人になっていただき、\n感謝しますシラエスさん……\nいえ、シラエスママ！",
    "serif_type": 1
  },
  {
    "id": 300002003,
    "m_event_id": 300002,
    "m_character_id": 1300034,
    "character_asset_id": "106801000G",
    "position": 1,
    "face": "Normal",
    "serif": "鬼ヶ島、か……\n千年以上冒険者をやっていたが、\n行くのは初めてだよ。楽しみだ",
    "serif_type": 1
  },
  {
    "id": 300002004,
    "m_event_id": 300002,
    "m_character_id": 1300034,
    "character_asset_id": "106801000G",
    "position": 1,
    "face": "Normal",
    "serif": "ふふ、クレハ君はいい子だな。\n時間をかけて仲良くなろう……\n１０年くらい……少し長いかな？",
    "serif_type": 1
  },
  {
    "id": 300002005,
    "m_event_id": 300002,
    "m_character_id": 1300029,
    "character_asset_id": "105801000G",
    "position": 1,
    "face": "Normal",
    "serif": "私と旦那の愛のパワーで、\n必ずや鬼ヶ島のプロデュースを\n成功させてみせます！",
    "serif_type": 1
  },
  {
    "id": 300002006,
    "m_event_id": 300002,
    "m_character_id": 1300029,
    "character_asset_id": "105801000G",
    "position": 1,
    "face": "Normal",
    "serif": "旦那様～♪　観光客のみなさまに\nお出しする料理ができました♪\n味見してください、あ～～ん♪",
    "serif_type": 1
  },
  {
    "id": 300002007,
    "m_event_id": 300002,
    "m_character_id": 1300034,
    "character_asset_id": "106801000G",
    "position": 1,
    "face": "Normal",
    "serif": "みんな張り切っているね……\n私も、精一杯盛り上げるとしよう。\nあ、よいしょよいしょ",
    "serif_type": 1
  },
  {
    "id": 300002008,
    "m_event_id": 300002,
    "m_character_id": 1300034,
    "character_asset_id": "106801000G",
    "position": 1,
    "face": "Normal",
    "serif": "サクラ役なら任せてほしい。\n伊達に歳を重ねてないからな。\n演技には自信があるよ",
    "serif_type": 1
  },
  {
    "id": 300002009,
    "m_event_id": 300002,
    "m_character_id": 1300029,
    "character_asset_id": "105801000G",
    "position": 1,
    "face": "Normal",
    "serif": "ありがとうございます、旦那様。\n鬼族と人が仲良くなれる日が\n来るなんて……夢のようですっ",
    "serif_type": 2
  },
  {
    "id": 300002010,
    "m_event_id": 300002,
    "m_character_id": 1300029,
    "character_asset_id": "105801000G",
    "position": 1,
    "face": "Normal",
    "serif": "それでは鬼族のみんな……！\n次は旦那様とシラエスママを\nもてなしますよ～♪",
    "serif_type": 2
  },
  {
    "id": 300002011,
    "m_event_id": 300002,
    "m_character_id": 1300034,
    "character_asset_id": "106801000G",
    "position": 1,
    "face": "Normal",
    "serif": "ふふ、人間と同じくらい\n鬼族のみんなを大好きになったよ",
    "serif_type": 2
  },
  {
    "id": 300002012,
    "m_event_id": 300002,
    "m_character_id": 1300034,
    "character_asset_id": "106801000G",
    "position": 1,
    "face": "Normal",
    "serif": "鬼ヶ島での出来事は、\n何千年経とうが色褪せない、\n素晴らしい思い出だよ",
    "serif_type": 2
  },
  {
    "id": 300003001,
    "m_event_id": 300003,
    "m_character_id": 1300049,
    "character_asset_id": "112001000G",
    "position": 1,
    "face": "Normal",
    "serif": "わぁ～～いっ、うみだ～～っ！\nうみ、うみぃ～～♪\nクルル、犬かきうまいんだよ～！",
    "serif_type": 1
  },
  {
    "id": 300003002,
    "m_event_id": 300003,
    "m_character_id": 1300049,
    "character_asset_id": "112001000G",
    "position": 1,
    "face": "Normal",
    "serif": "ニンギョって貝殻でオッパイ\nかくしてる女の子でしょ～？\nホントにいるのかなぁ～？",
    "serif_type": 1
  },
  {
    "id": 300003003,
    "m_event_id": 300003,
    "m_character_id": 1300050,
    "character_asset_id": "110901000G",
    "position": 1,
    "face": "Normal",
    "serif": "こ、この装備は、御主人様が海で\n溺れたりした際に、お助けする\n為の装備ですから！",
    "serif_type": 1
  },
  {
    "id": 300003004,
    "m_event_id": 300003,
    "m_character_id": 1300050,
    "character_asset_id": "110901000G",
    "position": 1,
    "face": "Normal",
    "serif": "日差しが強いですから、\n御主人様も水分補給は\nマメにしてくださいね",
    "serif_type": 1
  },
  {
    "id": 300003005,
    "m_event_id": 300003,
    "m_character_id": 1300049,
    "character_asset_id": "112001000G",
    "position": 1,
    "face": "Normal",
    "serif": "よぉ～～し！　みんなでいくよ！\nドクロ岩へレッツゴーだ！\nヘイリーとヒマリをたすけよう！",
    "serif_type": 1
  },
  {
    "id": 300003006,
    "m_event_id": 300003,
    "m_character_id": 1300049,
    "character_asset_id": "112001000G",
    "position": 1,
    "face": "Normal",
    "serif": "クルルが岩の上で見たの\nぜ～～ったいニンギョだよ！\n半分お魚だったもんっ！",
    "serif_type": 1
  },
  {
    "id": 300003007,
    "m_event_id": 300003,
    "m_character_id": 1300050,
    "character_asset_id": "110901000G",
    "position": 1,
    "face": "Normal",
    "serif": "御主人様御安心を\nホノカさんが作ったこの武器は\n対水棲モンスター用ですから！",
    "serif_type": 1
  },
  {
    "id": 300003008,
    "m_event_id": 300003,
    "m_character_id": 1300050,
    "character_asset_id": "110901000G",
    "position": 1,
    "face": "Normal",
    "serif": "ヒマリさんは絶対に生きています\nわたくしたちの手で\n必ず救い出しましょう！",
    "serif_type": 1
  },
  {
    "id": 300003009,
    "m_event_id": 300003,
    "m_character_id": 1300049,
    "character_asset_id": "112001000G",
    "position": 1,
    "face": "Normal",
    "serif": "ホノカやめてよ～～！！\nその辛いのかけないでぇ～～！",
    "serif_type": 2
  },
  {
    "id": 300003010,
    "m_event_id": 300003,
    "m_character_id": 1300049,
    "character_asset_id": "112001000G",
    "position": 1,
    "face": "Normal",
    "serif": "今回も楽しかったね～♪\n海でみんなで遊べたし♪\n強い敵もたおしちゃったし♪",
    "serif_type": 2
  },
  {
    "id": 300003011,
    "m_event_id": 300003,
    "m_character_id": 1300050,
    "character_asset_id": "110901000G",
    "position": 1,
    "face": "Normal",
    "serif": "もうっ！　御主人様ったら、\nすぐにあぁやって、わたくしを\nからかうんですから……",
    "serif_type": 2
  },
  {
    "id": 300003012,
    "m_event_id": 300003,
    "m_character_id": 1300050,
    "character_asset_id": "110901000G",
    "position": 1,
    "face": "Normal",
    "serif": "色々とありましたが、\n海ってすごくいい場所ですね。\nまた、来たいな……",
    "serif_type": 2
  },
  {
    "id": 300004001,
    "m_event_id": 300004,
    "m_character_id": 1300053,
    "character_asset_id": "110301000G",
    "position": 1,
    "face": "Normal",
    "serif": "このままじゃレストランが\n潰れちゃうよぉ～！\nふ、不幸だぁ～～！",
    "serif_type": 1
  },
  {
    "id": 300004002,
    "m_event_id": 300004,
    "m_character_id": 1300053,
    "character_asset_id": "110301000G",
    "position": 1,
    "face": "Normal",
    "serif": "うぅぅ、見ず知らずの私たちを\n助けてくれるなんて……\nみんな優しいよぉ……っ",
    "serif_type": 1
  },
  {
    "id": 300004003,
    "m_event_id": 300004,
    "m_character_id": 1300054,
    "character_asset_id": "102201000G",
    "position": 1,
    "face": "Normal",
    "serif": "ナイアさんの料理こそ至高――\nこのレストランを潰させる\nわけにはいきません",
    "serif_type": 1
  },
  {
    "id": 300004004,
    "m_event_id": 300004,
    "m_character_id": 1300054,
    "character_asset_id": "102201000G",
    "position": 1,
    "face": "Normal",
    "serif": "ナイアさんのオムライスを\nいつも食べれるなんて……\nフェルさん羨ましいなぁ",
    "serif_type": 1
  },
  {
    "id": 300004005,
    "m_event_id": 300004,
    "m_character_id": 1300053,
    "character_asset_id": "110301000G",
    "position": 1,
    "face": "Normal",
    "serif": "フェルちゃんとユーリちゃんが\n頑張ってくれてるんだもん――\n泣き言は言ってられないよね",
    "serif_type": 1
  },
  {
    "id": 300004006,
    "m_event_id": 300004,
    "m_character_id": 1300053,
    "character_asset_id": "110301000G",
    "position": 1,
    "face": "Normal",
    "serif": "どんな不幸に見舞われても、\n絶対に諦めないんだから～～っ",
    "serif_type": 1
  },
  {
    "id": 300004007,
    "m_event_id": 300004,
    "m_character_id": 1300054,
    "character_asset_id": "102201000G",
    "position": 1,
    "face": "Normal",
    "serif": "吹雪の山道に比べたら、\nこの程度の試練なんか\nへっちゃらです",
    "serif_type": 1
  },
  {
    "id": 300004008,
    "m_event_id": 300004,
    "m_character_id": 1300054,
    "character_asset_id": "102201000G",
    "position": 1,
    "face": "Normal",
    "serif": "ナイアさんの信者として――\nフェルさんの友として――\n必ず二人をお助けします",
    "serif_type": 1
  },
  {
    "id": 300004009,
    "m_event_id": 300004,
    "m_character_id": 1300053,
    "character_asset_id": "110301000G",
    "position": 1,
    "face": "Normal",
    "serif": "うぅぅ～～！\nやったよ、フェルちゃん――！\n私たちのお家を守れたよぉ～！",
    "serif_type": 2
  },
  {
    "id": 300004010,
    "m_event_id": 300004,
    "m_character_id": 1300053,
    "character_asset_id": "110301000G",
    "position": 1,
    "face": "Normal",
    "serif": "ユーリちゃんたちと\n別れるのは寂しいけど……\n絶対に、また会いにいくからねっ",
    "serif_type": 2
  },
  {
    "id": 300004011,
    "m_event_id": 300004,
    "m_character_id": 1300054,
    "character_asset_id": "102201000G",
    "position": 1,
    "face": "Normal",
    "serif": "しれー。\n絶対にまたナイアさんの料理を\n食べにいきましょうね",
    "serif_type": 2
  },
  {
    "id": 300004012,
    "m_event_id": 300004,
    "m_character_id": 1300054,
    "character_asset_id": "102201000G",
    "position": 1,
    "face": "Normal",
    "serif": "つまみ食い同盟の絆は\n永久不滅ですよ、フェルさん",
    "serif_type": 2
  },
  {
    "id": 27,
    "m_event_id": 500001,
    "m_character_id": 1300027,
    "character_asset_id": "105601000G",
    "position": 0,
    "face": "Normal",
    "serif": "ヘンリエッタ台詞",
    "serif_type": 0
  },
  {
    "id": 28,
    "m_event_id": 500001,
    "m_character_id": 1300037,
    "character_asset_id": "107201000G",
    "position": 1,
    "face": "Normal",
    "serif": "アシュリー台詞",
    "serif_type": 0
  },
  {
    "id": 50000201,
    "m_event_id": 500002,
    "m_character_id": 1300027,
    "character_asset_id": "113501000G",
    "position": 0,
    "face": "Normal",
    "serif": "【水着】ホノカ",
    "serif_type": 0
  },
  {
    "id": 50000202,
    "m_event_id": 500002,
    "m_character_id": 1300037,
    "character_asset_id": "113601000G",
    "position": 0,
    "face": "Normal",
    "serif": "【水着】ヘイリー",
    "serif_type": 0
  },
  {
    "id": 30,
    "m_event_id": 600001,
    "m_character_id": 1300010,
    "character_asset_id": "101001000G",
    "position": 0,
    "face": "Normal",
    "serif": "",
    "serif_type": 0
  },
  {
    "id": 31,
    "m_event_id": 600001,
    "m_character_id": 1300001,
    "character_asset_id": "100901000G",
    "position": 0,
    "face": "Normal",
    "serif": "",
    "serif_type": 0
  },
  {
    "id": 60000201,
    "m_event_id": 600002,
    "m_character_id": 1300035,
    "character_asset_id": "106901000G",
    "position": 0,
    "face": "Normal",
    "serif": "",
    "serif_type": 0
  },
  {
    "id": 60000202,
    "m_event_id": 600002,
    "m_character_id": 1200019,
    "character_asset_id": "107101000G",
    "position": 0,
    "face": "Normal",
    "serif": "",
    "serif_type": 0
  },
  {
    "id": 48,
    "m_event_id": 700001,
    "m_character_id": 1300018,
    "character_asset_id": "102301000G",
    "position": 0,
    "face": "Normal",
    "serif": "",
    "serif_type": 0
  },
  {
    "id": 36,
    "m_event_id": 800001,
    "m_character_id": 1300002,
    "character_asset_id": "300601000",
    "position": 1,
    "face": "Normal",
    "serif": "大穴で産出される武具は\nミレスガルドの戦力強化に有益\n優先的に買い取らせて欲しい",
    "serif_type": 0
  },
  {
    "id": 37,
    "m_event_id": 800001,
    "m_character_id": 1300002,
    "character_asset_id": "300601000",
    "position": 1,
    "face": "Normal",
    "serif": "王都の防衛で手が離せぬ今、\n前線の指揮は\nあの男に任せるしかない、か……",
    "serif_type": 0
  },
  {
    "id": 38,
    "m_event_id": 800001,
    "m_character_id": 1300002,
    "character_asset_id": "300601000",
    "position": 1,
    "face": "Normal",
    "serif": "ソフィアが信頼する人物……\nその手並み拝見させてもらうぞ",
    "serif_type": 0
  },
  {
    "id": 8000021,
    "m_event_id": 800002,
    "m_character_id": 1300002,
    "character_asset_id": "300701000",
    "position": 1,
    "face": "Normal",
    "serif": "お姉様も無茶言うわね……\r\n司令官、悪いんだけど\r\nお願い出来るかしら？",
    "serif_type": 0
  },
  {
    "id": 8000022,
    "m_event_id": 800002,
    "m_character_id": 1300002,
    "character_asset_id": "300701000",
    "position": 1,
    "face": "Normal",
    "serif": "見定めさせてもらうわ。\n彼がこの世界の命運を託すに\n値する人物かどうか……",
    "serif_type": 0
  },
  {
    "id": 8000023,
