[
  {
    "id": 1,
    "m_event_id": 300001,
    "m_character_id": 1300009,
    "character_asset_id": "100801000G",
    "position": 1,
    "serif": "ふふ。サプライズにしないと、\n司令官さまは恥ずかしがって、\n逃げちゃいそうですからねー",
    "serif_type": 1
  },
  {
    "id": 2,
    "m_event_id": 300001,
    "m_character_id": 1300009,
    "character_asset_id": "100801000G",
    "position": 1,
    "serif": "ウェンディさん、とっても\n張り切ってる……わたしたちも\n頑張ろうね、お姉ちゃん♪",
    "serif_type": 1
  },
  {
    "id": 3,
    "m_event_id": 300001,
    "m_character_id": 1300020,
    "character_asset_id": "102501000G",
    "position": 1,
    "serif": "サプライズパーティー……\n司令官、喜んでくれると\nいいなぁ～",
    "serif_type": 1
  },
  {
    "id": 4,
    "m_event_id": 300001,
    "m_character_id": 1300020,
    "character_asset_id": "102501000G",
    "position": 1,
    "serif": "えへへ……ヴィーラさんと\nベリサさんと一緒に準備するの、\nとっても楽しいです♪",
    "serif_type": 1
  },
  {
    "id": 5,
    "m_event_id": 300001,
    "m_character_id": 1300020,
    "character_asset_id": "100801000G",
    "position": 1,
    "serif": "ウェンディさんのためにも、\n必ずサプライズパーティーを\n成功させてみせます……！",
    "serif_type": 1
  },
  {
    "id": 6,
    "m_event_id": 300001,
    "m_character_id": 1200016,
    "character_asset_id": "100801000G",
    "position": 1,
    "serif": "もう、お姉ちゃんったら。\nウェンディさんを喜ばせたいって\n素直に言えばいいのに……ふふ",
    "serif_type": 1
  },
  {
    "id": 7,
    "m_event_id": 300001,
    "m_character_id": 1200016,
    "character_asset_id": "102501000G",
    "position": 1,
    "serif": "ヴィーラさん、ベリサさん……\nお二人が友だちでいてくれて、\nわたし、本当に幸せ者ですっ",
    "serif_type": 1
  },
  {
    "id": 8,
    "m_event_id": 300001,
    "m_character_id": 1200016,
    "character_asset_id": "102501000G",
    "position": 1,
    "serif": "友情の力は無限大です……！\nぱわぁぁぁぁぁあああ！！！！",
    "serif_type": 1
  },
  {
    "id": 9,
    "m_event_id": 300001,
    "m_character_id": 1200016,
    "character_asset_id": "102501000G",
    "position": 1,
    "serif": "司令官に喜んでもらえました～！\nサプライズ、大成功です♪",
    "serif_type": 2
  },
  {
    "id": 10,
    "m_event_id": 300001,
    "m_character_id": 1200016,
    "character_asset_id": "102501000G",
    "position": 1,
    "serif": "ヴィーラさん、ベリサさん、\n本当にありがとうござます！\n大好きです♪",
    "serif_type": 2
  },
  {
    "id": 11,
    "m_event_id": 300001,
    "m_character_id": 1200016,
    "character_asset_id": "100801000G",
    "position": 1,
    "serif": "ウェンディさん、\nとっても嬉しそう……\nえへへ、やったねお姉ちゃん♪",
    "serif_type": 2
  },
  {
    "id": 12,
    "m_event_id": 300001,
    "m_character_id": 1200016,
    "character_asset_id": "100801000G",
    "position": 1,
    "serif": "ふふ……\n次は、わたしとお姉ちゃんの\n再会パーティーもしなくっちゃ♪",
    "serif_type": 2
  },
  {
    "id": 300002001,
    "m_event_id": 300002,
    "m_character_id": 1300029,
    "character_asset_id": "105801000G",
    "position": 1,
    "serif": "旦那様が私と一緒に鬼ヶ島へ\n里帰りしてくださるのですか！？\nもしや結婚の挨拶のために！？",
    "serif_type": 1
  },
  {
    "id": 300002002,
    "m_event_id": 300002,
    "m_character_id": 1300029,
    "character_asset_id": "105801000G",
    "position": 1,
    "serif": "仲人になっていただき、\n感謝しますシラエスさん……\nいえ、シラエスママ！",
    "serif_type": 1
  },
  {
    "id": 300002003,
    "m_event_id": 300002,
    "m_character_id": 1300034,
    "character_asset_id": "106801000G",
    "position": 1,
    "serif": "鬼ヶ島、か……\n千年以上冒険者をやっていたが、\n行くのは初めてだよ。楽しみだ",
    "serif_type": 1
  },
  {
    "id": 300002004,
    "m_event_id": 300002,
    "m_character_id": 1300034,
    "character_asset_id": "106801000G",
    "position": 1,
    "serif": "ふふ、クレハ君はいい子だな。\n時間をかけて仲良くなろう……\n１０年くらい……少し長いかな？",
    "serif_type": 1
  },
  {
    "id": 300002005,
    "m_event_id": 300002,
    "m_character_id": 1300029,
    "character_asset_id": "105801000G",
    "position": 1,
    "serif": "私と旦那の愛のパワーで、\n必ずや鬼ヶ島のプロデュースを\n成功させてみせます！",
    "serif_type": 1
  },
  {
    "id": 300002006,
    "m_event_id": 300002,
    "m_character_id": 1300029,
    "character_asset_id": "105801000G",
    "position": 1,
    "serif": "旦那様～♪　観光客のみなさまに\nお出しする料理ができました♪\n味見してください、あ～～ん♪",
    "serif_type": 1
  },
  {
    "id": 300002007,
    "m_event_id": 300002,
    "m_character_id": 1300034,
    "character_asset_id": "106801000G",
    "position": 1,
    "serif": "みんな張り切っているね……\n私も、精一杯盛り上げるとしよう。\nあ、よいしょよいしょ",
    "serif_type": 1
  },
  {
    "id": 300002008,
    "m_event_id": 300002,
    "m_character_id": 1300034,
    "character_asset_id": "106801000G",
    "position": 1,
    "serif": "サクラ役なら任せてほしい。\n伊達に歳を重ねてないからな。\n演技には自信があるよ",
    "serif_type": 1
  },
  {
    "id": 300002009,
    "m_event_id": 300002,
    "m_character_id": 1300029,
    "character_asset_id": "105801000G",
    "position": 1,
    "serif": "ありがとうございます、旦那様。\n鬼族と人が仲良くなれる日が\n来るなんて……夢のようですっ",
    "serif_type": 2
  },
  {
    "id": 300002010,
    "m_event_id": 300002,
    "m_character_id": 1300029,
    "character_asset_id": "105801000G",
    "position": 1,
    "serif": "それでは鬼族のみんな……！\n次は旦那様とシラエスママを\nもてなしますよ～♪",
    "serif_type": 2
  },
  {
    "id": 300002011,
    "m_event_id": 300002,
    "m_character_id": 1300034,
    "character_asset_id": "106801000G",
    "position": 1,
    "serif": "ふふ、人間と同じくらい\n鬼族のみんなを大好きになったよ",
    "serif_type": 2
  },
  {
    "id": 300002012,
    "m_event_id": 300002,
    "m_character_id": 1300034,
    "character_asset_id": "106801000G",
    "position": 1,
    "serif": "鬼ヶ島での出来事は、\n何千年経とうが色褪せない、\n素晴らしい思い出だよ",
    "serif_type": 2
  },
  {
    "id": 300003001,
    "m_event_id": 300003,
    "m_character_id": 1300049,
    "character_asset_id": "112001000G",
    "position": 1,
    "serif": "わぁ～～いっ、うみだ～～っ！\nうみ、うみぃ～～♪\nクルル、犬かきうまいんだよ～！",
    "serif_type": 1
  },
  {
    "id": 300003002,
    "m_event_id": 300003,
    "m_character_id": 1300049,
    "character_asset_id": "112001000G",
    "position": 1,
    "serif": "ニンギョって貝殻でオッパイ\nかくしてる女の子でしょ～？\nホントにいるのかなぁ～？",
    "serif_type": 1
  },
  {
    "id": 300003003,
    "m_event_id": 300003,
    "m_character_id": 1300050,
    "character_asset_id": "110901000G",
    "position": 1,
    "serif": "こ、この装備は、御主人様が海で\n溺れたりした際に、お助けする\n為の装備ですから！",
    "serif_type": 1
  },
  {
    "id": 300003004,
    "m_event_id": 300003,
    "m_character_id": 1300050,
    "character_asset_id": "110901000G",
    "position": 1,
    "serif": "日差しが強いですから、\n御主人様も水分補給は\nマメにしてくださいね",
    "serif_type": 1
  },
  {
    "id": 300003005,
    "m_event_id": 300003,
    "m_character_id": 1300049,
    "character_asset_id": "112001000G",
    "position": 1,
    "serif": "よぉ～～し！　みんなでいくよ！\nドクロ岩へレッツゴーだ！\nヘイリーとヒマリをたすけよう！",
    "serif_type": 1
  },
  {
    "id": 300003006,
    "m_event_id": 300003,
    "m_character_id": 1300049,
    "character_asset_id": "112001000G",
    "position": 1,
    "serif": "クルルが岩の上で見たの\nぜ～～ったいニンギョだよ！\n半分お魚だったもんっ！",
    "serif_type": 1
  },
  {
    "id": 300003007,
    "m_event_id": 300003,
    "m_character_id": 1300050,
    "character_asset_id": "110901000G",
    "position": 1,
    "serif": "御主人様御安心を\nホノカさんが作ったこの武器は\n対水棲モンスター用ですから！",
    "serif_type": 1
  },
  {
    "id": 300003008,
    "m_event_id": 300003,
    "m_character_id": 1300050,
    "character_asset_id": "110901000G",
    "position": 1,
    "serif": "ヒマリさんは絶対に生きています\nわたくしたちの手で\n必ず救い出しましょう！",
    "serif_type": 1
  },
  {
    "id": 300003009,
    "m_event_id": 300003,
    "m_character_id": 1300049,
    "character_asset_id": "112001000G",
    "position": 1,
    "serif": "ホノカやめてよ～～！！\nその辛いのかけないでぇ～～！",
    "serif_type": 2
  },
  {
    "id": 300003010,
    "m_event_id": 300003,
    "m_character_id": 1300049,
    "character_asset_id": "112001000G",
    "position": 1,
    "serif": "今回も楽しかったね～♪\n海でみんなで遊べたし♪\n強い敵もたおしちゃったし♪",
    "serif_type": 2
  },
  {
    "id": 300003011,
    "m_event_id": 300003,
    "m_character_id": 1300050,
    "character_asset_id": "110901000G",
    "position": 1,
    "serif": "もうっ！　御主人様ったら、\nすぐにあぁやって、わたくしを\nからかうんですから……",
    "serif_type": 2
  },
  {
    "id": 300003012,
    "m_event_id": 300003,
    "m_character_id": 1300050,
    "character_asset_id": "110901000G",
    "position": 1,
    "serif": "色々とありましたが、\n海ってすごくいい場所ですね。\nまた、来たいな……",
    "serif_type": 2
  },
  {
    "id": 27,
    "m_event_id": 500001,
    "m_character_id": 1300027,
    "character_asset_id": "105601000G",
    "position": 0,
    "serif": "ヘンリエッタ台詞",
    "serif_type": 0
  },
  {
